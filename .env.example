# ==============================================================================
# ENCALM PROJECT DASHBOARD - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
API_PORT=5000
BASE_PATH=/

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Strong random secret key for JWT token signing.
# Generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-strong-random-secret-key-32-chars-minimum

# Allowed CORS origins (comma-separated). Leave empty to restrict to same-origin.
# Example: https://projects.encalm.com,https://app.encalm.com
CORS_ORIGIN=

# Safeguard against accidental database resets in production mode.
# Set to 'true' only when intentionally performing an administrative database reset.
ALLOW_SYSTEM_RESET=false

# ------------------------------------------------------------------------------
# 3. DATABASE & STORAGE
# ------------------------------------------------------------------------------
# Path where SQLite database (encalm.db) and uploads folder will be persisted.
# Default: ./server/data
DATA_DIR=

# ------------------------------------------------------------------------------
# 4. EMAIL PROVIDER - SMTP CONFIGURATION (Office 365 / Exchange / Generic)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@encalm.com
SMTP_PASS=
SMTP_FROM_NAME=Encalm Project Dashboard
SMTP_FROM_EMAIL=notifications@encalm.com
SMTP_ALLOW_SELF_SIGNED=false

# ------------------------------------------------------------------------------
# 5. EMAIL PROVIDER - MICROSOFT GRAPH API (AZURE AD OAUTH)
# ------------------------------------------------------------------------------
# Required if using Microsoft Graph API instead of basic SMTP
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER_EMAIL=notifications@encalm.com

# ------------------------------------------------------------------------------
# 6. CLIENT-SIDE ENVIRONMENT VARIABLES (Vite bundle exposed)
# ------------------------------------------------------------------------------
VITE_APP_NAME=Encalm Project Dashboard
VITE_ORG_NAME=Encalm Hospitality
# Leave empty for same-origin production deployments
VITE_API_URL=
